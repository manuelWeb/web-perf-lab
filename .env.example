# disable source map in production
BUILD_LOCAL=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXX
NEXT_PUBLIC_DATADOG_APPLICATION_ID=ton_application_id
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=ton_client_token
# Laisser vide pour choisir automatiquement local-development ou local-build.
NEXT_PUBLIC_DATADOG_ENV=
# Activer ponctuellement RUM dans npm run dev.
NEXT_PUBLIC_DATADOG_ENABLE_DEV=false
